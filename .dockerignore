.git
.venv
.venv-scripts
__pycache__
*.pyc
clientes/
dev-data/
# Estado de la instancia que `libracore.config_manager` deja en el cwd cuando
# se corre sin DATA_DIR (el uvicorn local del README). El contenedor lee su
# propio DATA_DIR, asi que estas copias no las usa nadie -- pero `config.json`
# puede tener el token de MercadoPago y la clave SMTP del que la genero, y
# `COPY . .` la hornearia en la imagen. Mismo par que en `.gitignore`.
config.json
logos/
frontend/node_modules
frontend/dist

# Lo que NO tiene que entrar a ninguna imagen. Existe porque las imágenes de dev se
# construyen desde el checkout del servidor, y ese checkout guarda datos de clientes
# reales (`clientes/<slug>/data`: la clave de ARCA, la config, los PDF), los respaldos
# `*_backup_*.tar.gz` y el `.env` del compose. Medido el 2026-10-02: sin esto iban
# adentro de la imagen. Las de producción se construyen desde un clon limpio y no
# tenían el problema.
data/
data-*/
.env
.env.*
!.env.example
*.bak*
*_backup*
*.tar.gz
*.dump
facturas_pdf/
presupuestos_pdf/
remitos_pdf/
